NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password
DB_NAME=events_db

# JWT (Required, min 32 chars, no default in code!)
JWT_SECRET=replace_with_at_least_32_characters_random_secret_key
JWT_EXPIRES_IN=15m

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
